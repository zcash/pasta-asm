/-- Registers carried by one checked iteration of `divsteps31`. -/
structure Divsteps31State where
  a3 : Nat
  cnt : Nat
  b3 : Nat
  fg1 : Nat
  fg0 : Nat
  deriving DecidableEq, Repr
/-- One source loop iteration of `divsteps31`. The wrapper validates and calls it exactly 31 times.
-/
def divsteps31Round (bias : Nat) (acc : Divsteps31State) : Divsteps31State :=
  let bias := bias                  -- invariant argument
  let a3 := acc.a3                  -- loop state argument
  let cnt := acc.cnt                -- loop state argument
  let b3 := acc.b3                  -- loop state argument
  let fg1 := acc.fg1                -- loop state argument
  let fg0 := acc.fg0                -- loop state argument
  let t3 := sbfx a3 0 1             -- sbfx t3,a3,#0,#1
  let cnt := sub cnt 1              -- sub cnt,cnt,#1
  let t0 := bitAnd b3 t3            -- and t0,b3,t3
  let t1 := sub b3 a3               -- sub t1,b3,a3
  let s := subc a3 t0 1             -- subs t2,a3,t0
  let t2 := s.1                     --   `-> t2
  let c := s.2                      --   `-> carry
  let t0 := fg1                     -- mov t0,fg1
  let b3 := cselCs c b3 a3          -- csel b3,b3,a3,hs
  let a3 := cselCs c t2 t1          -- csel a3,t2,t1,hs
  let fg1 := cselCs c fg1 fg0       -- csel fg1,fg1,fg0,hs
  let fg0 := cselCs c fg0 t0        -- csel fg0,fg0,t0,hs
  let a3 := lsr a3 1                -- lsr a3,a3,#1
  let t0 := bitAnd fg1 t3           -- and t0,fg1,t3
  let t1 := bitAnd bias t3          -- and t1,bias,t3
  let fg0 := sub fg0 t0             -- sub fg0,fg0,t0
  let fg1 := add fg1 fg1            -- add fg1,fg1,fg1
  let fg0 := add fg0 t1             -- add fg0,fg0,t1
  let fg1 := sub fg1 bias           -- sub fg1,fg1,bias
  ⟨a3, cnt, b3, fg1, fg0⟩

