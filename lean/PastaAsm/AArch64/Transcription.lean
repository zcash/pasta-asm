  let a_46 := round46.a             -- loop iteration 46 output
  let cnt_46 := round46.cnt         -- loop iteration 46 output
  let b_46 := round46.b             -- loop iteration 46 output
  let f0_46 := round46.f0           -- loop iteration 46 output
  let g0_46 := round46.g0           -- loop iteration 46 output
  let f1_46 := round46.f1           -- loop iteration 46 output
  let g1_46 := round46.g1           -- loop iteration 46 output
  let round47 := divsteps47Round ⟨a_46, cnt_46, b_46, f0_46, g0_46, f1_46, g1_46⟩  -- loop iteration 47
  let f1_47 := round47.f1           -- loop iteration 47 output
  let g1_47 := round47.g1           -- loop iteration 47 output
  ⟨f1_47, g1_47⟩

/-- The final signed coefficient adjustment; the low half is unchanged and the adjusted high half is
returned. -/
def normalizeCoefficient (value : WideLimbs) (modulus : Limbs) : CoefficientSplit :=
  let p0 := modulus.l0              -- argument
  let p1 := modulus.l1              -- argument
  let w4 := value.l4                -- argument
  let w5 := value.l5                -- argument
  let w6 := value.l6                -- argument
  let w7 := value.l7                -- argument
  let w8 := value.l8                -- argument
  let sign := asr w8 63             -- asr sign,w8,#63
  let m4 := lsl p0 1                -- lsl m4,p0,#1
  let tmp := lsr p0 63              -- lsr tmp,p0,#63
  let m5 := orr tmp (lsl p1 1)      -- orr m5,tmp,p1,lsl #1
  let m6 := lsr p1 63               -- lsr m6,p1,#63
  let m7 := 9223372036854775808     -- mov m7,#0x8000000000000000
  let tmp := bitAnd m4 sign         -- and tmp,m4,sign
  let s := addc w4 tmp 0            -- adds w4,w4,tmp
  let w4 := s.1                     --   `-> w4
  let c := s.2                      --   `-> carry
  let tmp := bitAnd m5 sign         -- and tmp,m5,sign
  let s := addc w5 tmp c            -- adcs w5,w5,tmp
  let w5 := s.1                     --   `-> w5
  let c := s.2                      --   `-> carry
  let tmp := bitAnd m6 sign         -- and tmp,m6,sign
  let s := addc w6 tmp c            -- adcs w6,w6,tmp
  let w6 := s.1                     --   `-> w6
  let c := s.2                      --   `-> carry
  let tmp := bitAnd m7 sign         -- and tmp,m7,sign
  let s := addc w7 tmp c            -- adcs w7,w7,tmp
  let w7 := s.1                     --   `-> w7
  let c := s.2                      --   `-> carry
  let w8 := (addc w8 0 c).1         -- adc w8,w8,xzr
  let sign := neg w8                -- neg sign,w8
  let excess := orr w8 sign         -- orr excess,w8,sign
  let sign := asr sign 63           -- asr sign,sign,#63
  let m4 := bitAnd m4 excess        -- and m4,m4,excess
  let m5 := bitAnd m5 excess        -- and m5,m5,excess
  let m6 := bitAnd m6 excess        -- and m6,m6,excess
  let m7 := bitAnd m7 excess        -- and m7,m7,excess
  let m4 := eor m4 sign             -- eor m4,m4,sign
  let m5 := eor m5 sign             -- eor m5,m5,sign
  let s := addc m4 (lsr sign 63) 0  -- adds m4,m4,sign,lsr #63
  let m4 := s.1                     --   `-> m4
  let c := s.2                      --   `-> carry
  let m6 := eor m6 sign             -- eor m6,m6,sign
  let s := addc m5 0 c              -- adcs m5,m5,xzr
  let m5 := s.1                     --   `-> m5
  let c := s.2                      --   `-> carry
  let m7 := eor m7 sign             -- eor m7,m7,sign
  let s := addc m6 0 c              -- adcs m6,m6,xzr
  let m6 := s.1                     --   `-> m6
  let c := s.2                      --   `-> carry
  let m7 := (addc m7 0 c).1         -- adc m7,m7,xzr
  let s := addc w4 m4 0             -- adds w4,w4,m4
  let w4 := s.1                     --   `-> w4
  let c := s.2                      --   `-> carry
  let s := addc w5 m5 c             -- adcs w5,w5,m5
  let w5 := s.1                     --   `-> w5
  let c := s.2                      --   `-> carry
  let s := addc w6 m6 c             -- adcs w6,w6,m6
  let w6 := s.1                     --   `-> w6
  let c := s.2                      --   `-> carry
  let w7 := (addc w7 m7 c).1        -- adc w7,w7,m7
  ⟨⟨value.l0, value.l1, value.l2, value.l3⟩, ⟨w4, w5, w6, w7⟩⟩

/-- One conditional subtraction of the modulus from a value known to be below twice it. -/
def reduceOnce (value modulus : Limbs) : Limbs :=
  let r0 := value.l0                -- argument
  let r1 := value.l1                -- argument
  let r2 := value.l2                -- argument
  let r3 := value.l3                -- argument
  let p0 := modulus.l0              -- argument
  let p1 := modulus.l1              -- argument
  let p2 := modulus.l2              -- argument
  let p3 := modulus.l3              -- argument
  let s := subc r0 p0 1             -- subs t0,r0,p0
  let t0 := s.1                     --   `-> t0
  let c := s.2                      --   `-> carry
  let s := subc r1 p1 c             -- sbcs t1,r1,p1
  let t1 := s.1                     --   `-> t1
  let c := s.2                      --   `-> carry
  let s := subc r2 p2 c             -- sbcs t2,r2,p2
  let t2 := s.1                     --   `-> t2
  let c := s.2                      --   `-> carry
  let s := subc r3 p3 c             -- sbcs t3,r3,p3
  let t3 := s.1                     --   `-> t3
  let c := s.2                      --   `-> carry
  let r0 := cselCs c t0 r0          -- csel r0,t0,r0,cs
  let r1 := cselCs c t1 r1          -- csel r1,t1,r1,cs
  let r2 := cselCs c t2 r2          -- csel r2,t2,r2,cs
  let r3 := cselCs c t3 r3          -- csel r3,t3,r3,cs
  ⟨r0, r1, r2, r3⟩

end PastaAsm.AArch64
