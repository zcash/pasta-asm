  let round29 := divsteps31Round bias ⟨a3, cnt, b3, fg1, fg0⟩  -- loop iteration 29
  let a3 := round29.a3              -- loop iteration 29 output
  let cnt := round29.cnt            -- loop iteration 29 output
  let b3 := round29.b3              -- loop iteration 29 output
  let fg1 := round29.fg1            -- loop iteration 29 output
  let fg0 := round29.fg0            -- loop iteration 29 output
  let round30 := divsteps31Round bias ⟨a3, cnt, b3, fg1, fg0⟩  -- loop iteration 30
  let a3 := round30.a3              -- loop iteration 30 output
  let cnt := round30.cnt            -- loop iteration 30 output
  let b3 := round30.b3              -- loop iteration 30 output
  let fg1 := round30.fg1            -- loop iteration 30 output
  let fg0 := round30.fg0            -- loop iteration 30 output
  let round31 := divsteps31Round bias ⟨a3, cnt, b3, fg1, fg0⟩  -- loop iteration 31
  let fg1 := round31.fg1            -- loop iteration 31 output
  let fg0 := round31.fg0            -- loop iteration 31 output
  let bias := ubfx bias 0 32        -- ubfx bias,bias,#0,#32
  let f0 := ubfx fg0 0 32           -- ubfx f0,fg0,#0,#32
  let g0 := ubfx fg0 32 32          -- ubfx g0,fg0,#32,#32
  let f1 := ubfx fg1 0 32           -- ubfx f1,fg1,#0,#32
  let g1 := ubfx fg1 32 32          -- ubfx g1,fg1,#32,#32
  let f0 := sub f0 bias             -- sub f0,f0,bias
  let g0 := sub g0 bias             -- sub g0,g0,bias
  let f1 := sub f1 bias             -- sub f1,f1,bias
  let g1 := sub g1 bias             -- sub g1,g1,bias
  ⟨f0, g0, f1, g1⟩

/-- The signed fixed-width matrix-row update of one GCD state, shifted by 31 bits. -/
def updateAB (a b : Limbs) (f g : Nat) : UpdateABResult :=
  let a0 := a.l0                    -- argument
  let a1 := a.l1                    -- argument
  let a2 := a.l2                    -- argument
  let a3 := a.l3                    -- argument
  let b0 := b.l0                    -- argument
  let b1 := b.l1                    -- argument
  let b2 := b.l2                    -- argument
  let b3 := b.l3                    -- argument
  let f := f                        -- argument
  let g := g                        -- argument
  let t5 := asr f 63                -- asr t5,f,#63
  let t6 := eor f t5                -- eor t6,f,t5
  let a0 := eor a0 t5               -- eor a0,a0,t5
  let t6 := sub t6 t5               -- sub t6,t6,t5
  let a1 := eor a1 t5               -- eor a1,a1,t5
  let s := addc a0 (lsr t5 63) 0    -- adds a0,a0,t5,lsr #63
  let a0 := s.1                     --   `-> a0
  let c := s.2                      --   `-> carry
  let a2 := eor a2 t5               -- eor a2,a2,t5
  let s := addc a1 0 c              -- adcs a1,a1,xzr
  let a1 := s.1                     --   `-> a1
  let c := s.2                      --   `-> carry
  let a3 := eor a3 t5               -- eor a3,a3,t5
  let t0 := umulh a0 t6             -- umulh t0,a0,t6
  let s := addc a2 0 c              -- adcs a2,a2,xzr
  let a2 := s.1                     --   `-> a2
  let c := s.2                      --   `-> carry
  let t1 := umulh a1 t6             -- umulh t1,a1,t6
  let a3 := (addc a3 0 c).1         -- adc a3,a3,xzr
  let t2 := umulh a2 t6             -- umulh t2,a2,t6
  let t5 := bitAnd t5 t6            -- and t5,t5,t6
  let t3 := umulh a3 t6             -- umulh t3,a3,t6
  let t5 := neg t5                  -- neg t5,t5
  let a0 := mulLo a0 t6             -- mul a0,a0,t6
  let a1 := mulLo a1 t6             -- mul a1,a1,t6
  let a2 := mulLo a2 t6             -- mul a2,a2,t6
  let s := addc a1 t0 0             -- adds a1,a1,t0
  let a1 := s.1                     --   `-> a1
  let c := s.2                      --   `-> carry
  let a3 := mulLo a3 t6             -- mul a3,a3,t6
  let s := addc a2 t1 c             -- adcs a2,a2,t1
  let a2 := s.1                     --   `-> a2
  let c := s.2                      --   `-> carry
  let s := addc a3 t2 c             -- adcs a3,a3,t2
  let a3 := s.1                     --   `-> a3
  let c := s.2                      --   `-> carry
  let t3 := (addc t3 t5 c).1        -- adc t3,t3,t5
  let t5 := asr g 63                -- asr t5,g,#63
  let t6 := eor g t5                -- eor t6,g,t5
  let b0 := eor b0 t5               -- eor b0,b0,t5
  let t6 := sub t6 t5               -- sub t6,t6,t5
  let b1 := eor b1 t5               -- eor b1,b1,t5
  let s := addc b0 (lsr t5 63) 0    -- adds b0,b0,t5,lsr #63
  let b0 := s.1                     --   `-> b0
  let c := s.2                      --   `-> carry
  let b2 := eor b2 t5               -- eor b2,b2,t5
  let s := addc b1 0 c              -- adcs b1,b1,xzr
  let b1 := s.1                     --   `-> b1
  let c := s.2                      --   `-> carry
  let b3 := eor b3 t5               -- eor b3,b3,t5
  let t0 := umulh b0 t6             -- umulh t0,b0,t6
  let s := addc b2 0 c              -- adcs b2,b2,xzr
  let b2 := s.1                     --   `-> b2
  let c := s.2                      --   `-> carry
  let t1 := umulh b1 t6             -- umulh t1,b1,t6
  let b3 := (addc b3 0 c).1         -- adc b3,b3,xzr
  let t2 := umulh b2 t6             -- umulh t2,b2,t6
  let t5 := bitAnd t5 t6            -- and t5,t5,t6
  let t4 := umulh b3 t6             -- umulh t4,b3,t6
  let t5 := neg t5                  -- neg t5,t5
  let b0 := mulLo b0 t6             -- mul b0,b0,t6
  let b1 := mulLo b1 t6             -- mul b1,b1,t6
  let b2 := mulLo b2 t6             -- mul b2,b2,t6
  let s := addc b1 t0 0             -- adds b1,b1,t0
  let b1 := s.1                     --   `-> b1
  let c := s.2                      --   `-> carry
  let b3 := mulLo b3 t6             -- mul b3,b3,t6
  let s := addc b2 t1 c             -- adcs b2,b2,t1
  let b2 := s.1                     --   `-> b2
  let c := s.2                      --   `-> carry
  let s := addc b3 t2 c             -- adcs b3,b3,t2
  let b3 := s.1                     --   `-> b3
  let c := s.2                      --   `-> carry
  let t4 := (addc t4 t5 c).1        -- adc t4,t4,t5
  let s := addc a0 b0 0             -- adds a0,a0,b0
  let a0 := s.1                     --   `-> a0
  let c := s.2                      --   `-> carry
  let s := addc a1 b1 c             -- adcs a1,a1,b1
  let a1 := s.1                     --   `-> a1
  let c := s.2                      --   `-> carry
  let s := addc a2 b2 c             -- adcs a2,a2,b2
  let a2 := s.1                     --   `-> a2
  let c := s.2                      --   `-> carry
  let s := addc a3 b3 c             -- adcs a3,a3,b3
  let a3 := s.1                     --   `-> a3
  let c := s.2                      --   `-> carry
  let b0 := (addc t3 t4 c).1        -- adc b0,t3,t4
  let a0 := extr a1 a0 31           -- extr a0,a1,a0,#31
  let a1 := extr a2 a1 31           -- extr a1,a2,a1,#31
  let a2 := extr a3 a2 31           -- extr a2,a3,a2,#31
  let t4 := asr b0 63               -- asr t4,b0,#63
  let a3 := extr b0 a3 31           -- extr a3,b0,a3,#31
  let a0 := eor a0 t4               -- eor a0,a0,t4
  let a1 := eor a1 t4               -- eor a1,a1,t4
  let s := addc a0 (lsr t4 63) 0    -- adds a0,a0,t4,lsr #63
  let a0 := s.1                     --   `-> a0
  let c := s.2                      --   `-> carry
  let a2 := eor a2 t4               -- eor a2,a2,t4
  let s := addc a1 0 c              -- adcs a1,a1,xzr
  let a1 := s.1                     --   `-> a1
  let c := s.2                      --   `-> carry
  let a3 := eor a3 t4               -- eor a3,a3,t4
  let s := addc a2 0 c              -- adcs a2,a2,xzr
  let a2 := s.1                     --   `-> a2
  let c := s.2                      --   `-> carry
  let a3 := (addc a3 0 c).1         -- adc a3,a3,xzr
  let f := eor f t4                 -- eor f,f,t4
  let g := eor g t4                 -- eor g,g,t4
  let f := sub f t4                 -- sub f,f,t4
  let g := sub g t4                 -- sub g,g,t4
  ⟨⟨a0, a1, a2, a3⟩, f, g⟩

/-- Addition of two nine-word coefficient bitpatterns modulo 2^576. -/
def addWords (lhs rhs : WideLimbs) : WideLimbs :=
  let o0 := lhs.l0                  -- argument
  let o1 := lhs.l1                  -- argument
  let o2 := lhs.l2                  -- argument
  let o3 := lhs.l3                  -- argument
  let o4 := lhs.l4                  -- argument
  let o5 := lhs.l5                  -- argument
  let o6 := lhs.l6                  -- argument
  let o7 := lhs.l7                  -- argument
  let o8 := lhs.l8                  -- argument
  let r0 := rhs.l0                  -- argument
  let r1 := rhs.l1                  -- argument
  let r2 := rhs.l2                  -- argument
  let r3 := rhs.l3                  -- argument
  let r4 := rhs.l4                  -- argument
  let r5 := rhs.l5                  -- argument
  let r6 := rhs.l6                  -- argument
  let r7 := rhs.l7                  -- argument
  let r8 := rhs.l8                  -- argument
  let s := addc o0 r0 0             -- adds o0,o0,r0
  let o0 := s.1                     --   `-> o0
  let c := s.2                      --   `-> carry
  let s := addc o1 r1 c             -- adcs o1,o1,r1
  let o1 := s.1                     --   `-> o1
  let c := s.2                      --   `-> carry
  let s := addc o2 r2 c             -- adcs o2,o2,r2
  let o2 := s.1                     --   `-> o2
  let c := s.2                      --   `-> carry
  let s := addc o3 r3 c             -- adcs o3,o3,r3
  let o3 := s.1                     --   `-> o3
  let c := s.2                      --   `-> carry
  let s := addc o4 r4 c             -- adcs o4,o4,r4
  let o4 := s.1                     --   `-> o4
  let c := s.2                      --   `-> carry
  let s := addc o5 r5 c             -- adcs o5,o5,r5
  let o5 := s.1                     --   `-> o5
  let c := s.2                      --   `-> carry
  let s := addc o6 r6 c             -- adcs o6,o6,r6
  let o6 := s.1                     --   `-> o6
  let c := s.2                      --   `-> carry
  let s := addc o7 r7 c             -- adcs o7,o7,r7
  let o7 := s.1                     --   `-> o7
  let c := s.2                      --   `-> carry
  let o8 := (addc o8 r8 c).1        -- adc o8,o8,r8
  ⟨o0, o1, o2, o3, o4, o5, o6, o7, o8⟩

/-- The magnitude and conditionally negated limbs produced by the first contiguous source phase of
`mulSigned`. -/
structure MulSignedPrepared where
  l0 : Nat
  l1 : Nat
  l2 : Nat
  l3 : Nat
  l4 : Nat
  l5 : Nat
  l6 : Nat
  l7 : Nat
  l8 : Nat
  magnitude : Nat
  deriving DecidableEq, Repr

namespace MulSignedPrepared

/-- The register bounds supplied by a proof of the prepare/sign-negation phase. -/
def Bounded (s : MulSignedPrepared) : Prop :=
  s.l0 < 2^64 ∧ s.l1 < 2^64 ∧ s.l2 < 2^64 ∧ s.l3 < 2^64 ∧ s.l4 < 2^64 ∧
  s.l5 < 2^64 ∧ s.l6 < 2^64 ∧ s.l7 < 2^64 ∧ s.l8 < 2^64 ∧ s.magnitude < 2^64

end MulSignedPrepared

/-- The low product limb and carry produced by a non-final contiguous product phase of
`mulSigned`. -/
structure MulSignedProduct where
  low : Nat
  carry : Nat
  deriving DecidableEq, Repr

namespace MulSignedProduct

/-- The register bounds supplied by each non-final product-phase proof. -/
def Bounded (s : MulSignedProduct) : Prop :=
  s.low < 2^64 ∧ s.carry < 2^64

end MulSignedProduct

/-- The low limb produced by the final contiguous product phase of `mulSigned`. -/
structure MulSignedLastProduct where
  low : Nat
  deriving DecidableEq, Repr

namespace MulSignedLastProduct

/-- The register bound supplied by the final product-phase proof. -/
def Bounded (s : MulSignedLastProduct) : Prop :=
  s.low < 2^64

end MulSignedLastProduct

/-- The contiguous scalar-magnitude and conditional-negation phase of `mulSigned`, copied from
source PCs 0 through 20. -/
def mulSignedPrepare (value : WideLimbs) (scalar : Nat) : MulSignedPrepared :=
  let scalar := scalar              -- argument
  let o0 := value.l0                -- argument
  let o1 := value.l1                -- argument
  let o2 := value.l2                -- argument
  let o3 := value.l3                -- argument
  let o4 := value.l4                -- argument
  let o5 := value.l5                -- argument
  let o6 := value.l6                -- argument
  let o7 := value.l7                -- argument
  let o8 := value.l8                -- argument
  let sign := asr scalar 63         -- asr sign,scalar,#63
  let mag := eor scalar sign        -- eor mag,scalar,sign
  let mag := sub mag sign           -- sub mag,mag,sign
  let o0 := eor o0 sign             -- eor o0,o0,sign
  let o1 := eor o1 sign             -- eor o1,o1,sign
  let o2 := eor o2 sign             -- eor o2,o2,sign
  let o3 := eor o3 sign             -- eor o3,o3,sign
  let o4 := eor o4 sign             -- eor o4,o4,sign
  let o5 := eor o5 sign             -- eor o5,o5,sign
  let o6 := eor o6 sign             -- eor o6,o6,sign
  let o7 := eor o7 sign             -- eor o7,o7,sign
  let o8 := eor o8 sign             -- eor o8,o8,sign
  let s := addc o0 (lsr sign 63) 0  -- adds o0,o0,sign,lsr #63
  let o0 := s.1                     --   `-> o0
  let c := s.2                      --   `-> carry
  let s := addc o1 0 c              -- adcs o1,o1,xzr
  let o1 := s.1                     --   `-> o1
  let c := s.2                      --   `-> carry
  let s := addc o2 0 c              -- adcs o2,o2,xzr
  let o2 := s.1                     --   `-> o2
  let c := s.2                      --   `-> carry
  let s := addc o3 0 c              -- adcs o3,o3,xzr
  let o3 := s.1                     --   `-> o3
  let c := s.2                      --   `-> carry
  let s := addc o4 0 c              -- adcs o4,o4,xzr
  let o4 := s.1                     --   `-> o4
  let c := s.2                      --   `-> carry
  let s := addc o5 0 c              -- adcs o5,o5,xzr
  let o5 := s.1                     --   `-> o5
  let c := s.2                      --   `-> carry
  let s := addc o6 0 c              -- adcs o6,o6,xzr
  let o6 := s.1                     --   `-> o6
  let c := s.2                      --   `-> carry
  let s := addc o7 0 c              -- adcs o7,o7,xzr
  let o7 := s.1                     --   `-> o7
  let c := s.2                      --   `-> carry
  let o8 := (addc o8 0 c).1         -- adc o8,o8,xzr
  ⟨o0, o1, o2, o3, o4, o5, o6, o7, o8, mag⟩

/-- The first contiguous product phase of `mulSigned`: multiply limb zero and retain its high word
as the carry. -/
def mulSignedFirst (limb magnitude : Nat) : MulSignedProduct :=
  let o0 := limb                    -- phase argument
  let mag := magnitude              -- phase argument
  let carry := umulh o0 mag         -- umulh carry,o0,mag
  let o0 := mulLo o0 mag            -- mul o0,o0,mag
  ⟨o0, carry⟩

/-- One middle contiguous product phase of `mulSigned`. All seven unrolled source phases are checked
to have this binding IR after source-limb normalization. -/
def mulSignedRound (limb magnitude productCarry : Nat) : MulSignedProduct :=
  let o1 := limb                    -- phase argument
  let mag := magnitude              -- phase argument
  let carry := productCarry         -- phase argument
  let hi := umulh o1 mag            -- umulh hi,o1,mag
  let o1 := mulLo o1 mag            -- mul o1,o1,mag
  let s := addc o1 carry 0          -- adds o1,o1,carry
  let o1 := s.1                     --   `-> o1
  let c := s.2                      --   `-> carry
  let carry := (addc hi 0 c).1      -- adc carry,hi,xzr
  ⟨o1, carry⟩

/-- The final contiguous product phase of `mulSigned`, with overflow above bit 575 discarded exactly
as in the source. -/
def mulSignedLast (limb magnitude productCarry : Nat) : MulSignedLastProduct :=
  let o8 := limb                    -- phase argument
  let mag := magnitude              -- phase argument
  let carry := productCarry         -- phase argument
  let o8 := mulLo o8 mag            -- mul o8,o8,mag
  let o8 := add o8 carry            -- add o8,o8,carry
  ⟨o8⟩

/-- Multiplication of a nine-word signed bitpattern by a signed scalar bitpattern modulo 2^576. -/
def mulSigned (value : WideLimbs) (scalar : Nat) : WideLimbs :=
  let prepared := mulSignedPrepare value scalar  -- factored prepare/sign-negation phase
  let o0 := prepared.l0             -- prepare/sign-negation phase output
  let o1 := prepared.l1             -- prepare/sign-negation phase output
  let o2 := prepared.l2             -- prepare/sign-negation phase output
  let o3 := prepared.l3             -- prepare/sign-negation phase output
  let o4 := prepared.l4             -- prepare/sign-negation phase output
  let o5 := prepared.l5             -- prepare/sign-negation phase output
  let o6 := prepared.l6             -- prepare/sign-negation phase output
  let o7 := prepared.l7             -- prepare/sign-negation phase output
  let o8 := prepared.l8             -- prepare/sign-negation phase output
  let mag := prepared.magnitude     -- prepare/sign-negation phase output
  let firstProduct := mulSignedFirst o0 mag  -- factored first product phase
  let o0 := firstProduct.low        -- first product phase output
  let carry := firstProduct.carry   -- first product phase output
  let round1 := mulSignedRound o1 mag carry  -- factored product round 1
  let o1 := round1.low              -- product round 1 output
  let carry := round1.carry         -- product round 1 output
  let round2 := mulSignedRound o2 mag carry  -- factored product round 2
  let o2 := round2.low              -- product round 2 output
  let carry := round2.carry         -- product round 2 output
  let round3 := mulSignedRound o3 mag carry  -- factored product round 3
  let o3 := round3.low              -- product round 3 output
  let carry := round3.carry         -- product round 3 output
  let round4 := mulSignedRound o4 mag carry  -- factored product round 4
  let o4 := round4.low              -- product round 4 output
  let carry := round4.carry         -- product round 4 output
  let round5 := mulSignedRound o5 mag carry  -- factored product round 5
  let o5 := round5.low              -- product round 5 output
  let carry := round5.carry         -- product round 5 output
  let round6 := mulSignedRound o6 mag carry  -- factored product round 6
  let o6 := round6.low              -- product round 6 output
  let carry := round6.carry         -- product round 6 output
  let round7 := mulSignedRound o7 mag carry  -- factored product round 7
  let o7 := round7.low              -- product round 7 output
  let carry := round7.carry         -- product round 7 output
  let lastProduct := mulSignedLast o8 mag carry  -- factored final product phase
  let o8 := lastProduct.low         -- final product phase output
  ⟨o0, o1, o2, o3, o4, o5, o6, o7, o8⟩

/-- Registers carried by one checked iteration of `divsteps47`. -/
structure Divsteps47State where
  a : Nat
  cnt : Nat
  b : Nat
  f0 : Nat
  g0 : Nat
  f1 : Nat
  g1 : Nat
  deriving DecidableEq, Repr
/-- One source loop iteration of `divsteps47`. The wrapper validates and calls it exactly 47 times.
-/
def divsteps47Round (acc : Divsteps47State) : Divsteps47State :=
  let a := acc.a                    -- loop state argument
  let cnt := acc.cnt                -- loop state argument
  let b := acc.b                    -- loop state argument
  let f0 := acc.f0                  -- loop state argument
  let g0 := acc.g0                  -- loop state argument
  let f1 := acc.f1                  -- loop state argument
  let g1 := acc.g1                  -- loop state argument
  let odd := sbfx a 0 1             -- sbfx odd,a,#0,#1
  let cnt := sub cnt 1              -- sub cnt,cnt,#1
  let t0 := bitAnd b odd            -- and t0,b,odd
  let t1 := sub b a                 -- sub t1,b,a
  let s := subc a t0 1              -- subs t2,a,t0
  let t2 := s.1                     --   `-> t2
  let c := s.2                      --   `-> carry
  let t0 := f0                      -- mov t0,f0
  let b := cselCs c b a             -- csel b,b,a,hs
  let a := cselCs c t2 t1           -- csel a,t2,t1,hs
  let t1 := g0                      -- mov t1,g0
  let f0 := cselCs c f0 f1          -- csel f0,f0,f1,hs
  let f1 := cselCs c f1 t0          -- csel f1,f1,t0,hs
  let g0 := cselCs c g0 g1          -- csel g0,g0,g1,hs
  let g1 := cselCs c g1 t1          -- csel g1,g1,t1,hs
  let a := lsr a 1                  -- lsr a,a,#1
  let t0 := bitAnd f1 odd           -- and t0,f1,odd
  let t1 := bitAnd g1 odd           -- and t1,g1,odd
  let f1 := add f1 f1               -- add f1,f1,f1
  let g1 := add g1 g1               -- add g1,g1,g1
  let f0 := sub f0 t0               -- sub f0,f0,t0
  let g0 := sub g0 t1               -- sub g0,g0,t1
  ⟨a, cnt, b, f0, g0, f1, g1⟩

/-- The second transition row after the checked fixed-count final 47 low-limb steps. -/
def divsteps47 (a b : Nat) : InvertRow :=
  let a' := a                       -- argument
  let b' := b                       -- argument
  let cnt := 47                     -- argument
  let f0 := 1                       -- argument
  let g0 := 0                       -- argument
  let f1 := 0                       -- argument
  let g1 := 1                       -- argument
  let round1 := divsteps47Round ⟨a', cnt, b', f0, g0, f1, g1⟩  -- loop iteration 1
  let a_1 := round1.a               -- loop iteration 1 output
  let cnt_1 := round1.cnt           -- loop iteration 1 output
  let b_1 := round1.b               -- loop iteration 1 output
  let f0_1 := round1.f0             -- loop iteration 1 output
  let g0_1 := round1.g0             -- loop iteration 1 output
  let f1_1 := round1.f1             -- loop iteration 1 output
  let g1_1 := round1.g1             -- loop iteration 1 output
  let round2 := divsteps47Round ⟨a_1, cnt_1, b_1, f0_1, g0_1, f1_1, g1_1⟩  -- loop iteration 2
  let a_2 := round2.a               -- loop iteration 2 output
  let cnt_2 := round2.cnt           -- loop iteration 2 output
  let b_2 := round2.b               -- loop iteration 2 output
  let f0_2 := round2.f0             -- loop iteration 2 output
  let g0_2 := round2.g0             -- loop iteration 2 output
  let f1_2 := round2.f1             -- loop iteration 2 output
  let g1_2 := round2.g1             -- loop iteration 2 output
