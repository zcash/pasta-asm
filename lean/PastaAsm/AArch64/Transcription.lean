  let c := s.2                  --   `-> carry
  let s := subc a1 p1 c         -- sbcs z1,a1,p1
  let z1 := s.1                 --   `-> z1
  let c := s.2                  --   `-> carry
  let s := subc a2 0 c          -- sbcs z2,a2,xzr
  let z2 := s.1                 --   `-> z2
  let c := s.2                  --   `-> carry
  let s := subc a3 q c          -- sbcs z3,a3,q
