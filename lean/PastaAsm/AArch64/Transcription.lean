  let a0 := cselLo c a0 z0      -- csel a0,a0,z0,lo
  let a1 := cselLo c a1 z1      -- csel a1,a1,z1,lo
  let a2 := cselLo c a2 z2      -- csel a2,a2,z2,lo
  let a3 := cselLo c a3 z3      -- csel a3,a3,z3,lo
