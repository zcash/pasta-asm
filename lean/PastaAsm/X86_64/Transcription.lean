  let z1 := s.1                  --   `-> z1
  let cf := s.2                  --   `-> cf
  let z2 := 0                    -- mov {z2}, 0
  let s := addc z2 0 cf          -- adc {z2}, 0
  let z2 := s.1                  --   `-> z2
  let cf := s.2                  --   `-> cf
  let m := mulx rdx p0           -- mulx {t1}, {z3}, {p0}
  let t1 := m.1                  --   `-> t1
  let z3 := m.2                  --   `-> z3
