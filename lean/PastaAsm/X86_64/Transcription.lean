  let z0 := 0                    -- mov {z0}, 0
  let s := addc z0 0 cf          -- adc {z0}, 0
  let z0 := s.1                  --   `-> z0
  let cf := s.2                  --   `-> cf
  let m := mulx rdx p0           -- mulx {t1}, {z1}, {p0}
  let t1 := m.1                  --   `-> t1
  let z1 := m.2                  --   `-> z1
  let z1 := rdx                  -- mov {z1}, rdx
  let z1 := lsr z1 2             -- shr {z1}, 2
  let s := addc z2 t1 0          -- add {z2}, {t1}
  let z2 := s.1                  --   `-> z2
  let cf := s.2                  --   `-> cf
  let s := addc z3 t2 cf         -- adc {z3}, {t2}
  let z3 := s.1                  --   `-> z3
  let cf := s.2                  --   `-> cf
  let s := addc a 0 cf           -- adc {a}, 0
  let a := s.1                   --   `-> a
  let cf := s.2                  --   `-> cf
  let s := addc z0 z1 cf         -- adc {z0}, {z1}
  let z0 := s.1                  --   `-> z0
  let cf := s.2                  --   `-> cf
  let rdx := z2                  -- mov rdx, {z2}
  let rdx := mulLo rdx inv       -- imul rdx, {inv}
  let m := mulx rdx p1           -- mulx {t2}, {t1}, {p1}
  let t2 := m.1                  --   `-> t2
  let t1 := m.2                  --   `-> t1
  let z1 := rdx                  -- mov {z1}, rdx
  let z1 := lsl z1 62            -- shl {z1}, 62
  let n := neg z2                -- neg {z2}
  let z2 := n.1                  --   `-> z2
  let cf := n.2                  --   `-> cf
  let s := addc z3 t1 cf         -- adc {z3}, {t1}
  let z3 := s.1                  --   `-> z3
  let cf := s.2                  --   `-> cf
  let s := addc a 0 cf           -- adc {a}, 0
  let a := s.1                   --   `-> a
  let cf := s.2                  --   `-> cf
  let s := addc z0 z1 cf         -- adc {z0}, {z1}
  let z0 := s.1                  --   `-> z0
  let cf := s.2                  --   `-> cf
  let z1 := 0                    -- mov {z1}, 0
  let s := addc z1 0 cf          -- adc {z1}, 0
  let z1 := s.1                  --   `-> z1
  let cf := s.2                  --   `-> cf
  let m := mulx rdx p0           -- mulx {t1}, {z2}, {p0}
