  let cf := s.2                  --   `-> cf
  let s := addc z1 z2 cf         -- adc {z1}, {z2}
  let z1 := s.1                  --   `-> z1
  let cf := s.2                  --   `-> cf
  let rdx := z3                  -- mov rdx, {z3}
  let rdx := mulLo rdx inv       -- imul rdx, {inv}
  let m := mulx rdx p1           -- mulx {t2}, {t1}, {p1}
  let t2 := m.1                  --   `-> t2
  let t1 := m.2                  --   `-> t1
  let z2 := rdx                  -- mov {z2}, rdx
  let z2 := lsl z2 62            -- shl {z2}, 62
  let n := neg z3                -- neg {z3}
  let z3 := n.1                  --   `-> z3
  let cf := n.2                  --   `-> cf
  let s := addc a t1 cf          -- adc {a}, {t1}
  let a := s.1                   --   `-> a
  let cf := s.2                  --   `-> cf
  let s := addc z0 0 cf          -- adc {z0}, 0
  let z0 := s.1                  --   `-> z0
  let cf := s.2                  --   `-> cf
