  let cf := s.2                  --   `-> cf
  let s := addc z0 t2 cf         -- adc {z0}, {t2}
  let z0 := s.1                  --   `-> z0
  let cf := s.2                  --   `-> cf
  let s := addc z1 0 cf          -- adc {z1}, 0
  let z1 := s.1                  --   `-> z1
  let cf := s.2                  --   `-> cf
  let s := addc z2 z3 cf         -- adc {z2}, {z3}
  let z2 := s.1                  --   `-> z2
  let cf := s.2                  --   `-> cf
  let rdx := p3                  -- movabs rdx, {p3}
  let t1 := a                    -- mov {t1}, {a}
  let t2 := z0                   -- mov {t2}, {z0}
  let z3 := z1                   -- mov {z3}, {z1}
  let z4 := z2                   -- mov {z4}, {z2}
